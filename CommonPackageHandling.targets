<Project>
	<Import Project="$(SolutionDir)ServiceVersioning.props" />
	<!-- Common properties for package handling -->
	<PropertyGroup>
		<PackageRepoFolder>$(SolutionDir)\..\Packages</PackageRepoFolder>
		<Copyright>Copyright (c) 2021 - 2026 Insight Sciences Corporation. All rights reserved.</Copyright>
		<PackageProjectUrl>https://LazyMagic.org</PackageProjectUrl>
		<RepositoryUrl>https://github.com/LazyMagicPets/MagicPetsService</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Company>Insight Sciences Corporation</Company>
		<Authors>Tim May, Thomas May</Authors>
		<!-- No <Version> here. ServiceVersioning.props brings in Nerdbank.GitVersioning, which
		     computes it from version.json plus commit height. A literal would be overridden at
		     target time with no warning at any verbosity, while restore still reads the literal at
		     evaluation time - a live trap, not a harmless default. -->
		<SignAssembly>false</SignAssembly>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- Set this to true in your csproj file to include referenced projects in the package -->
		<IncludeReferencedProjects Condition="'$(IncludeReferencedProjects)' == ''">false</IncludeReferencedProjects>
	</PropertyGroup>
	
	<!-- By default, MSBuild makes project references package references when producing a package for your project. 
		This has pros and cons. If you want to include all referenced project dlls in your package, set the
		IncludeReferencedProject property to true in your csproj file (before importing this props file). 
		In general, it is better to accept the default behavior and make all referenced projects nuget packages. 
		For example, if you have multiple projects producing nuget packages and each of those project reference 
		a common project, then each of those projects will have a copy of the common project's dll in their package.
		If your application includes both of the nuget packages, you will have two copies of the common project's dll.
	-->
	<!-- Conditionally set TargetsForTfmSpecificBuildOutput -->
	<PropertyGroup Condition="'$(IncludeReferencedProjects)' == 'true'">
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<!-- Target to copy dlls into the package. -->
	<Target Name="CreateDirectories" BeforeTargets="Build">
		<MakeDir Directories="$(SolutionDir)\Packages"/>
	</Target>
	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
		<ItemGroup>
			<_ReferenceCopyLocalPaths Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"/>
			<BuildOutputInPackage Include="@(_ReferenceCopyLocalPaths)" TargetPath="%(_ReferenceCopyLocalPaths.DestinationSubDirectory)"/>
		</ItemGroup>
	</Target>	
	
	<!-- Copy Package License --><!--
	<Target Name="CopyPackageLicense" BeforeTargets="Clean">
		<Copy SourceFiles="$(SolutionDir)\LICENSE.txt" DestinationFiles="LICENSE.txt" />
	</Target>
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="True" PackagePath=""/>
	</ItemGroup>-->
	<!-- Copy Package Target -->
	<Target Name="CopyPackage" AfterTargets="Pack">
		<PropertyGroup>
			<!-- Pack names its output <PackageId>.<normalized PackageVersion>, which is NOT
			     $(AssemblyName).$(Version): PackageId need not equal AssemblyName, build metadata
			     (+g1a2b3c) is dropped from the file name though not from $(Version), a fourth part of
			     .0 is dropped, and a two-part version is padded to three. Under the fixed 1.0.0 those
			     never diverged, so the old naive Copy worked by luck; under a derived version they do,
			     and the copy would fail with MSB3030 - leaving the previous version in the feed and
			     never publishing the one just built.

			     This reconstructs pack's name rather than reading it, so it models NuGet's
			     normalization and can be incomplete - leading zeros (1.0.010 -> 1.0.10) are NOT
			     modelled. That is why a miss is an Error, not a warning: nothing here gates on
			     warnings, so a silent miss would leave every consumer restoring stale bytes.

			     Not @(NuGetPackOutput), which looks authoritative but is a PREDICTION computed from
			     $(PackageId)/$(PackageVersion) before pack runs; whether it is right depends on which
			     hook the version tool uses. Reconstructing here does not depend on that, and unlike
			     the item it is checked against the disk.

			     $(PackageOutputPath) rather than a hardcoded bin\$(Configuration)\, so `dotnet pack -o`
			     no longer breaks the copy. -->
			<_PkgId>$(PackageId)</_PkgId>
			<_PkgId Condition=" '$(_PkgId)' == '' ">$(AssemblyName)</_PkgId>
			<_PkgVersion>$(PackageVersion)</_PkgVersion>
			<_PkgVersion Condition=" '$(_PkgVersion)' == '' ">$(Version)</_PkgVersion>
			<_PkgVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_PkgVersion)', '[+].*$', ''))</_PkgVersion>
			<_PkgVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_PkgVersion)', '^([0-9]+[.][0-9]+)(?=$|[-])', '$1.0'))</_PkgVersion>
			<_PkgVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_PkgVersion)', '^([0-9]+[.][0-9]+[.][0-9]+)[.]0(?=$|-)', '$1'))</_PkgVersion>
			<_PkgDir>$(PackageOutputPath)</_PkgDir>
			<_PkgDir Condition=" '$(_PkgDir)' == '' ">$(BaseOutputPath)$(Configuration)\</_PkgDir>
			<_PkgDir>$([MSBuild]::EnsureTrailingSlash('$(_PkgDir)'))</_PkgDir>
		</PropertyGroup>
		<ItemGroup>
			<_ProducedPackages Include="$(_PkgDir)$(_PkgId).$(_PkgVersion).nupkg" Condition="Exists('$(_PkgDir)$(_PkgId).$(_PkgVersion).nupkg')" />
			<_ProducedPackages Include="$(_PkgDir)$(_PkgId).$(_PkgVersion).snupkg" Condition="Exists('$(_PkgDir)$(_PkgId).$(_PkgVersion).snupkg')" />
		</ItemGroup>
		<Error Condition="'@(_ProducedPackages)' == '' AND '$(IsPackable)' != 'false'" Text="Pack produced no $(_PkgId).$(_PkgVersion).nupkg in $(_PkgDir), so nothing was published to $(PackageRepoFolder). The name above is this target's reconstruction of pack's: PackageId, then PackageVersion with build metadata stripped, a two-part version padded to three, and a fourth part of .0 dropped. NuGet normalizes leading zeros too, which this does not model - if that is what differs, look at the file pack actually wrote in $(_PkgDir)." />
		<Message Condition="'@(_ProducedPackages)' != ''" Importance="high" Text="Copying @(_ProducedPackages->'%(Filename)%(Extension)', ', ') to $(PackageRepoFolder)" />
		<MakeDir Condition="'@(_ProducedPackages)' != ''" Directories="$(PackageRepoFolder)" />
		<Copy Condition="'@(_ProducedPackages)' != ''" SourceFiles="@(_ProducedPackages)" DestinationFolder="$(PackageRepoFolder)" />
	</Target>

	<!-- Once the new package is in the feed, remove this id's SUPERSEDED packages from BOTH the feed
	     and the build output directory, so each holds one version per id. Runs after CopyPackage on
	     purpose: if the copy fails, the previous version stays in the feed rather than leaving the id
	     with nothing. The files just produced are excluded in both places, so a same-version rebuild
	     deletes nothing. The target does not run at all when pack produced nothing, so a feed can
	     never be emptied for an id this build did not replace.

	     Under a derived version every commit produces a new file name, and this is the only thing
	     stopping either directory growing without bound. Under the old fixed 1.0.0 it was
	     unnecessary, which is why this repo never had it.

	     ANCHORED ON THE VERSION, deliberately. A bare "$(PackageId).*.nupkg" glob would also match
	     every package whose id merely EXTENDS this one, so the glob only narrows the candidates and a
	     regex then requires "<id>." followed by a digit-led version. The regexes use character
	     classes and never a backslash: MSBuild on Linux/macOS rewrites literal backslashes in
	     property values to slashes. -->
	<Target Name="CleanExistingPackages" AfterTargets="CopyPackage" Condition="'@(_ProducedPackages)' != ''">
		<PropertyGroup>
			<_CleanId>$(PackageId)</_CleanId>
			<_CleanId Condition=" '$(_CleanId)' == '' ">$(AssemblyName)</_CleanId>
			<_OwnPackagePattern>(?i)^$([System.Text.RegularExpressions.Regex]::Escape('$(_CleanId)'))[.][0-9]+([.][0-9]+){1,3}(-[0-9a-z][0-9a-z.-]*)?([+][0-9a-z][0-9a-z.-]*)?[.]s?nupkg$</_OwnPackagePattern>
		</PropertyGroup>
		<ItemGroup>
			<_FeedCandidates Include="$(PackageRepoFolder)\$(_CleanId).*.nupkg;$(PackageRepoFolder)\$(_CleanId).*.snupkg;$(_PkgDir)$(_CleanId).*.nupkg;$(_PkgDir)$(_CleanId).*.snupkg"
			                 Exclude="@(_ProducedPackages);@(_ProducedPackages->'$(PackageRepoFolder)\%(Filename)%(Extension)')" />
			<_OwnPackages Include="@(_FeedCandidates)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_FeedCandidates.Filename)%(_FeedCandidates.Extension)', '$(_OwnPackagePattern)'))" />
		</ItemGroup>
		<Message Condition="'@(_OwnPackages)' != ''" Importance="high" Text="Removing superseded $(_CleanId) packages: @(_OwnPackages->'%(Filename)%(Extension)', ', ')" />
		<!-- A superseded file another process still has open is not worth failing the build over; it is
		     swept on the next build. -->
		<Delete Files="@(_OwnPackages)" TreatErrorsAsWarnings="true" Retries="2" RetryDelayMilliseconds="250" />
	</Target>
	<!-- Evict this project's package from the NuGet global-packages folder after every build, so the
	     next restore in a consumer re-extracts it from the feed instead of serving the cached copy. A
	     same-version repack is the ORDINARY case, not a legacy one: a derived version is a function of
	     git state, and the edit-and-rebuild loop does not advance the commit, so it recomputes the same
	     version and rewrites the same package with different bytes. Without eviction a consumer keeps
	     building against the stale bytes.

	     DeleteSpecificPackage now runs in THIS project instance (DependsOnTargets) rather than through
	     a child <MSBuild> call. That call was MEASURED on 2026-09-20 to resolve the derived version
	     correctly - it named 1.0.3 for all twelve packages, never the SDK default - because MSBuild
	     reused the parent's already-executed project instance rather than genuinely re-evaluating. That
	     is a property of the build graph, though, not a guarantee: the child call asks for a
	     re-evaluation, and an evaluation runs none of the targets a version tool sets the version in.
	     DependsOnTargets does not depend on the reuse happening.

	     SKIPPED IN THE CROSS-TARGETING OUTER BUILD. A project with <TargetFrameworks> (plural) builds
	     in two passes, and the outer pass runs none of the version tool's targets, so there $(Version)
	     is whatever static evaluation left - now the SDK default, since ServiceVersioning.props
	     replaced the literal. All twelve packing projects here are single-TFM net10.0 today, so this
	     guard is insurance against one becoming cross-targeting later. IsCrossTargetingBuild is set,
	     with this exact condition, by both Microsoft.NET.Sdk's Sdk.targets and MSBuild's
	     Microsoft.Managed.Before.targets; a target Condition is evaluated when the target RUNS, so it
	     sees that value even though this file is imported before the SDK's targets. -->
	<Target Name="DeletePackage" AfterTargets="Build" DependsOnTargets="DeleteSpecificPackage"
	        Condition="'$(IsCrossTargetingBuild)' != 'true'" />
	<Target Name="DeleteSpecificPackage">
		<PropertyGroup>
			<!-- Evict from the global-packages folder the restore ACTUALLY used, not a hardcoded
			     ~/.nuget/packages. $(NuGetPackageRoot) comes from the restore-generated nuget.g.props
			     and follows the per-workspace globalPackagesFolder set in the workspace Nuget.Config;
			     the old hardcoded path did not, so with a relocated cache this target evicted nothing
			     and the republish it exists for silently stopped working. NuGet writes a RELOCATED root
			     WITHOUT a trailing separator (the default has one), so it is ensured, or the path
			     collapses to "...\.nuget-packagesappapi\1.0.3" (seen 2026-09-02). Falls back to the
			     NuGet default only when no restore has run. -->
			<_PackageRoot>$(NuGetPackageRoot)</_PackageRoot>
			<_PackageRoot Condition=" '$(_PackageRoot)' == '' AND '$(OS)' == 'Windows_NT' ">$(UserProfile)\.nuget\packages\</_PackageRoot>
			<_PackageRoot Condition=" '$(_PackageRoot)' == '' AND '$(OS)' != 'Windows_NT' ">$(Home)/.nuget/packages/</_PackageRoot>
			<_PackageRoot>$([MSBuild]::EnsureTrailingSlash('$(_PackageRoot)'))</_PackageRoot>
			<!-- The id and version the package was ACTUALLY built with, read here after the version
			     tool has run: PackageVersion is what pack stamps, Version is its default. The old
			     target used $(AssemblyName) and a raw $(Version), both wrong in general - PackageId
			     need not equal AssemblyName, and NuGet names the cache folder by the lower-cased id and
			     the NORMALIZED, lower-cased version, with build metadata (+g1a2b3c) dropped and a
			     fourth part of 0 dropped. Under NBGV the -g<hash> suffix on a non-public branch makes
			     that difference real rather than theoretical. -->
			<_EvictId>$(PackageId)</_EvictId>
			<_EvictId Condition=" '$(_EvictId)' == '' ">$(AssemblyName)</_EvictId>
			<_EvictVersion>$(PackageVersion)</_EvictVersion>
			<_EvictVersion Condition=" '$(_EvictVersion)' == '' ">$(Version)</_EvictVersion>
			<_EvictVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_EvictVersion)', '[+].*$', ''))</_EvictVersion>
			<_EvictVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_EvictVersion)', '^([0-9]+[.][0-9]+)(?=$|[-])', '$1.0'))</_EvictVersion>
			<_EvictVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_EvictVersion)', '^([0-9]+[.][0-9]+[.][0-9]+)[.]0(?=$|-)', '$1'))</_EvictVersion>
			<_EvictVersion>$(_EvictVersion.ToLowerInvariant())</_EvictVersion>
			<PackageCacheFolder Condition=" '$(OS)' == 'Windows_NT' ">$(_PackageRoot)$(_EvictId.ToLowerInvariant())\$(_EvictVersion)</PackageCacheFolder>
			<PackageCacheFolder Condition=" '$(OS)' != 'Windows_NT' ">$(_PackageRoot)$(_EvictId.ToLowerInvariant())/$(_EvictVersion)</PackageCacheFolder>
		</PropertyGroup>
		<!-- Three honest outcomes, decided by STATE rather than by exit code. On Windows `rmdir /s /q`
		     exits 0 when a file inside is in use and it deleted only what it could, so an exit-code
		     test reports that as success. Exists() in a task condition is evaluated when the task runs,
		     after the Exec, and sees the post-deletion state.

		     THIS RETIRES THE "Failed to delete package. Error code: " LINE, which fired twelve times
		     per build here on the NOTHING-TO-EVICT path: the Exec is guarded by Exists(), so when there
		     was nothing to remove it never ran, $(ErrorCode) stayed empty, and '' != '0' is true - it
		     reported failure on the success path. The /build skill documents that noise as safe to
		     ignore; it is now gone rather than documented. -->
		<!-- A destructive delete NEVER runs on a version we could not determine. With $(_EvictVersion)
		     empty the path collapses to the id root and rmdir would take EVERY cached version of the
		     package. Nothing upstream should ever produce an empty version - the SDK defaults it, and
		     the two fallbacks above cover an unset PackageId - so this is a bug detector, not a
		     fallback path, and it warns rather than passing silently. -->
		<Warning Condition=" '$(_EvictVersion)' == '' " Text="No version could be determined for $(_EvictId); skipping the package-cache eviction rather than deleting every cached version of it. The build is producing a package whose version this target cannot see - check version.json and any &lt;Version&gt; override." />
		<Message Condition=" '$(_EvictVersion)' != '' AND !Exists('$(PackageCacheFolder)')" Importance="high" Text="No cached $(_EvictId) $(_EvictVersion) under $(_PackageRoot) - nothing to evict." />
		<Exec Condition=" '$(OS)' == 'Windows_NT' AND '$(_EvictVersion)' != '' AND Exists('$(PackageCacheFolder)')"
			  Command="cmd.exe /c &quot;if exist &quot;$(PackageCacheFolder)&quot; rmdir /s /q &quot;$(PackageCacheFolder)&quot;&quot;"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="_EvictExitCode"/>
		</Exec>
		<Exec Condition=" '$(OS)' != 'Windows_NT' AND '$(_EvictVersion)' != '' AND Exists('$(PackageCacheFolder)')"
			  Command="rm -rf &quot;$(PackageCacheFolder)&quot;"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="_EvictExitCode"/>
		</Exec>
		<Message Condition="'$(_EvictExitCode)' != '' AND !Exists('$(PackageCacheFolder)')" Importance="high" Text="Evicted $(PackageCacheFolder); the next restore re-extracts $(_EvictId) $(_EvictVersion) from the feed." />
		<Warning Condition="'$(_EvictExitCode)' != '' AND Exists('$(PackageCacheFolder)')" Text="Could not evict $(PackageCacheFolder) (exit $(_EvictExitCode); a file inside is probably in use) - a consumer may restore a STALE $(_EvictId) $(_EvictVersion). Close whatever holds it and rebuild." />
	</Target>

	<!-- =====================================================================================
	     Bracket the ranges this repo's packages declare on EACH OTHER.

	     The sibling packages (AppApi, the *Schema and *ModuleClientInterface set) depend on one
	     another through ProjectReference, not PackageReference, so central package management never
	     sees those edges and nothing in Directory.Packages.props affects them. Left alone, pack
	     writes them as minimums - "AdminSchema >= 1.0.2" - with no upper bound.

	     Under the old fixed 1.0.0 that was inert, because there was only ever one version. Under a
	     derived version it is not: a consumer resolving "AdminSchema >= 1.0.2" against a feed
	     holding 1.0.9 silently takes 1.0.9, and a set of packages built together stops being
	     consumed together. This is the same failure that put LazyMagic 3.0.17 and 3.0.29-alpha in
	     one graph on 2026-09-20.

	     THE RISK. @(_ProjectReferencesWithVersions) is SDK-INTERNAL - the underscore says so - so a
	     future SDK could rename it, at which point this target silently stops applying and open
	     ranges ship again with no error. Scutara covers that fail-open with a publish workflow that
	     refuses any package whose sibling range is not exact. THIS REPO HAS NO SUCH CHECK, so here
	     the mechanism is trusted rather than verified; add one if these packages are ever published
	     beyond the local feed.

	     SCOPE. ProjectReference-derived dependencies only. PackageReference dependencies reach the
	     nuspec by another path and are untouched: LazyMagic.* keeps the brackets CPM gives it in
	     Directory.Packages.props, and third-party dependencies stay minimums on purpose -
	     exact-pinning Newtonsoft.Json would hand consumers diamond conflicts for nothing.

	     CONSEQUENCE, deliberately chosen: a consumer must take the whole set at one version. Mixing
	     one sibling with a different version of another becomes a hard conflict rather than a silent
	     resolution. That is the point.
	     ===================================================================================== -->
	<Target Name="BracketSiblingProjectReferences" AfterTargets="_GetProjectReferenceVersions">
		<ItemGroup>
			<_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
					Condition="!$([System.String]::Copy('%(ProjectVersion)').StartsWith('['))">
				<ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
			</_ProjectReferencesWithVersions>
		</ItemGroup>
	</Target>
</Project>