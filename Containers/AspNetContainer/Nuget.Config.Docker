<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<!-- Docker build package cache - prepared by Deploy-DockerAws -->
		<!-- Using absolute path since build happens from /src/AspNetContainer -->
		<add key="DockerCache" value="/src/DockerPackages" />
		<!-- Fallback to nuget.org -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<fallbackPackageFolders>
		<clear />
	</fallbackPackageFolders>
</configuration>
