<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <RepoRootDir>$(MSBuildThisFileDirectory)</RepoRootDir>
    <CommonTargetsFile>$(RepoRootDir)CommonPackageHandling.targets</CommonTargetsFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Amazon.AspNetCore.Identity.Cognito" Version="3.2.2" />
    <PackageVersion Include="Amazon.Lambda.APIGatewayEvents" Version="2.7.1" />
    <PackageVersion Include="Amazon.Lambda.AspNetCoreServer" Version="9.2.0" />
    <PackageVersion Include="Amazon.Lambda.Core" Version="2.5.0" />
    <PackageVersion Include="Amazon.Lambda.DynamoDBEvents" Version="3.1.1" />
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="1.12.1" />
    <PackageVersion Include="Amazon.Lambda.Serialization.Json" Version="2.2.4" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.4" />
    <PackageVersion Include="AWSSDK.ApiGatewayManagementApi" Version="3.7.400.64" />
    <PackageVersion Include="AWSSDK.AppSync" Version="4.0.1.19" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.7" />
    <PackageVersion Include="AWSSDK.CognitoIdentityProvider" Version="4.0.3.5" />
    <PackageVersion Include="AWSSDK.CloudFront" Version="4.0.5.3" />
    <PackageVersion Include="AWSSDK.CloudFrontKeyValueStore" Version="4.0.0.24" />
    <PackageVersion Include="AWSSDK.Core" Version="3.7.400.59" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.6.4" />
    <PackageVersion Include="AWSSDK.Extensions.CrtIntegration" Version="4.0.0.3" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3.2" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.2.4" />
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.1.4" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.2.1" />
    <PackageVersion Include="DeepCloner" Version="0.10.4" />
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="JsonSubTypes" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Microsoft.AspNetCore.Mvc.NewtonsoftJson 9.0.0 is not compatible with .NET8 use 8.0.11 -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="NLog" Version="5.3.4" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageVersion Include="System.Text.Json" Version="9.0.8" />
    <PackageVersion Include="System.Threading.Channels" Version="9.0.8" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="LazyMagic.Service.AwsLocalWebApiRoutingMiddleware" Version="3.0.1" />
    <PackageVersion Include="LazyMagic.Service.DynamoDBRepo" Version="3.0.1" />
    <PackageVersion Include="LazyMagic.Service.Authorization" Version="3.0.1" />
    <PackageVersion Include="LazyMagic.Service.Shared" Version="3.0.1" />
    <PackageVersion Include="LazyMagic.Shared" Version="3.0.1" />
  </ItemGroup>
</Project>