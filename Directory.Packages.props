<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <RepoRootDir>$(MSBuildThisFileDirectory)</RepoRootDir>
    <CommonTargetsFile>$(RepoRootDir)CommonPackageHandling.targets</CommonTargetsFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Amazon.AspNetCore.Identity.Cognito" Version="4.0.0" />
    <PackageVersion Include="Amazon.Lambda.APIGatewayEvents" Version="2.7.1" />
    <PackageVersion Include="Amazon.Lambda.AspNetCoreServer" Version="9.2.0" />
    <PackageVersion Include="Amazon.Lambda.Core" Version="2.7.0" />
    <PackageVersion Include="Amazon.Lambda.DynamoDBEvents" Version="3.1.1" />
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="1.12.1" />
    <PackageVersion Include="Amazon.Lambda.Serialization.Json" Version="2.2.4" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.4" />
    <PackageVersion Include="AWSSDK.ApiGatewayManagementApi" Version="3.7.400.64" />
    <PackageVersion Include="AWSSDK.AppSync" Version="4.0.1.19" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.7" />
    <PackageVersion Include="AWSSDK.CognitoIdentityProvider" Version="4.0.3.5" />
    <PackageVersion Include="AWSSDK.CloudFormation" Version="4.0.3.3" />
    <PackageVersion Include="AWSSDK.CloudFront" Version="4.0.14" />
    <PackageVersion Include="AWSSDK.CloudFrontKeyValueStore" Version="4.0.1.28" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.7" />
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.18" />
    <PackageVersion Include="AWSSDK.Extensions.CrtIntegration" Version="4.0.0.36" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3.25" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.2.4" />
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.1.4" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.2.1" />
    <PackageVersion Include="AwsSignatureVersion4" Version="5.0.1" />
    <PackageVersion Include="DeepCloner" Version="0.10.4" />
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="JsonSubTypes" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="NLog" Version="5.3.4" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.5" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.5" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <!--
    LOCAL LANE. Each first-party pin below reads a property whose DEFAULT is the version this
    repo is committed against - the published lane, and what a fresh clone or CI restores with.
    `lz packages mode local` writes the override imported underneath, redirecting those
    properties at whatever the workspace feeds hold; deleting it returns to the published lane.
    `lz packages sync` re-baselines these defaults onto what the producers currently mint.

    THE IMPORT MUST STAY BELOW THESE DEFAULTS. Moved above them the defaults win, restore still
    succeeds, and the wrong version is used with no diagnostic anywhere.

    The property name is the package id with dots as underscores (Lz.Core PropertyName()), so a
    rename here that does not match breaks the override silently rather than loudly.
  -->
  <PropertyGroup>
    <PkgVer_LazyMagic_OIDC_Bff>3.0.17</PkgVer_LazyMagic_OIDC_Bff>
    <PkgVer_LazyMagic_Service_Authorization>3.0.17</PkgVer_LazyMagic_Service_Authorization>
    <PkgVer_LazyMagic_Service_AwsLocalWebApiRoutingMiddleware>3.0.17</PkgVer_LazyMagic_Service_AwsLocalWebApiRoutingMiddleware>
    <PkgVer_LazyMagic_Service_DynamoDBRepo>3.0.17</PkgVer_LazyMagic_Service_DynamoDBRepo>
    <PkgVer_LazyMagic_Service_Shared>3.0.17</PkgVer_LazyMagic_Service_Shared>
    <PkgVer_LazyMagic_Shared>3.0.17</PkgVer_LazyMagic_Shared>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../Packages.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)../../Packages.Local.props')" />
  <ItemGroup>
    <!-- BRACKETED ON PURPOSE. `Version="x"` is a MINIMUM, not a pin: NuGet reads it as "[x, )"
         both when restoring and when PACKING, so without the brackets every package this repo
         publishes (AppApi, the *Schema and *ModuleClientInterface packages) would tell its
         consumers "any LazyMagic at or above this", with no upper bound - and a packed range is
         fixed for that package version once pushed. LazyMagic is the wrong dependency to leave
         open: its version derives from commit height on an ALPHA line published from `dev`, a
         branch whose whole purpose is code that may never reach main.

         The brackets go HERE, around the property reference, rather than inside the $(PkgVer_*)
         values, so `lz packages mode local` and `lz packages sync` keep writing plain versions
         and BOTH lanes get exact ranges for free.

         Legal under CPM: NU1011 forbids FLOATING versions (1.* and friends), not bracket ranges.

         Sibling packages here depend on each other through ProjectReference, not
         PackageReference, so CPM never sees those and nothing in this file affects them. Scutara
         handles that with a BracketSiblingProjectReferences target in
         CommonPackageHandling.targets; this repo does not have it yet. -->
    <PackageVersion Include="LazyMagic.Service.AwsLocalWebApiRoutingMiddleware" Version="[$(PkgVer_LazyMagic_Service_AwsLocalWebApiRoutingMiddleware)]" />
    <PackageVersion Include="LazyMagic.Service.DynamoDBRepo" Version="[$(PkgVer_LazyMagic_Service_DynamoDBRepo)]" />
    <PackageVersion Include="LazyMagic.Service.Authorization" Version="[$(PkgVer_LazyMagic_Service_Authorization)]" />
    <PackageVersion Include="LazyMagic.Service.Shared" Version="[$(PkgVer_LazyMagic_Service_Shared)]" />
    <PackageVersion Include="LazyMagic.Shared" Version="[$(PkgVer_LazyMagic_Shared)]" />
    <PackageVersion Include="LazyMagic.OIDC.Bff" Version="[$(PkgVer_LazyMagic_OIDC_Bff)]" />
  </ItemGroup>
</Project>
