<Project>
  <!-- Non-generated extensibility seam for LocalWebService (imported by LocalWebService.csproj).
       Validates tokens and enforces the per-module pool rules with the same code AppHost uses. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <Compile Include="..\Containers\AppHost\ModuleAuthEnforcement.cs" Link="ModuleAuthEnforcement.cs" />
  </ItemGroup>
</Project>
